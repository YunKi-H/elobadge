# Production runtime. Copy to deploy/.env; never commit credentials.
# Setup and updates: docs/lightsail-deployment.md

# Docker Compose and Caddy
# Replace the example domain in APP_DOMAIN AND all OAuth redirect URIs.
APP_DOMAIN=badge.example.com
ELOBADGE_IMAGE=ghcr.io/yunki-h/elobadge:latest
# Compose sets NODE_ENV, PORT, and WEB_APP_URL automatically.
# VITE_FIREBASE_* values belong in the image build (GitHub Actions), not here.

# Firebase Admin SDK (server-only service-account fields)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key on one line with escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=
# A host GOOGLE_APPLICATION_CREDENTIALS path is not accessible inside the
# container unless the file is explicitly mounted. Use the fields above here.

# Chzzk
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=https://badge.example.com/api/auth/chzzk/callback
# Generate with: openssl rand -base64 32
# Keep stable while encrypted tokens exist.
CHZZK_TOKEN_ENCRYPTION_KEY=

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://badge.example.com/api/auth/twitch/callback
# Generate a separate key with: openssl rand -base64 32
TWITCH_TOKEN_ENCRYPTION_KEY=

# Chess.com
CHESS_COM_USER_AGENT=EloBadge/0.1 (contact: support@elobadge.com)

# Lichess (PKCE, no client secret)
LICHESS_CLIENT_ID=elobadge.com
LICHESS_REDIRECT_URI=https://badge.example.com/api/auth/lichess/callback

# Optional operations
# Comma-separated Firebase UIDs allowed to open /admin.
ADMIN_FIREBASE_UIDS=
# Extra allowed browser origins. https://APP_DOMAIN is allowed automatically.
CORS_ALLOWED_ORIGINS=
# Per-IP requests per minute; sensitive routes have their own limits.
RATE_LIMIT_MAX=300

# Optional Chzzk moderation (undocumented API; see docs/operations.md)
# Enable to remove displayed messages when a confirmed moderation event arrives.
CHZZK_PRIVATE_CHAT_MODERATION_ENABLED=false

# Temporary diagnostics (disabled by default)
CHZZK_BADGE_DIAGNOSTICS=false
# Test streamer Firebase UID allowlist for the private socket monitor.
CHZZK_PRIVATE_CHAT_DIAGNOSTIC_UIDS=

# Advanced API overrides. Omit these to use the public provider defaults.
# Do not set CHZZK_OPEN_API_BASE_URL to an empty value.
# CHZZK_OPEN_API_BASE_URL=https://openapi.chzzk.naver.com
# LICHESS_BASE_URL=https://lichess.org
