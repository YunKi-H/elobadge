# Local development. Copy to .env; never commit credentials.
# Use a development Firebase project, not production.
# Setup: docs/local-development.md

# Application
PORT=3000
WEB_APP_URL=http://localhost:5173

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
# Choose ONE credentials method:
# A: Local service-account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=
# B: Service-account fields. Leave these empty when using method A.
FIREBASE_CLIENT_EMAIL=
# Keep the key on one line with escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK (required for browser sign-in; these values are public)
# Use the same Firebase project as FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Chzzk (required when testing Chzzk)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=http://localhost:3000/api/auth/chzzk/callback
# Generate with: openssl rand -base64 32
# Keep stable while encrypted tokens exist.
CHZZK_TOKEN_ENCRYPTION_KEY=

# Twitch (required when testing Twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Generate a separate key with: openssl rand -base64 32
TWITCH_TOKEN_ENCRYPTION_KEY=

# Chess.com (required for linking and rating refresh)
CHESS_COM_USER_AGENT=EloBadge/0.1 (contact: support@elobadge.com)

# Lichess (required for linking; PKCE, no client secret)
LICHESS_CLIENT_ID=elobadge.com
LICHESS_REDIRECT_URI=http://localhost:3000/api/auth/lichess/callback

# Optional operations
# Comma-separated Firebase UIDs allowed to open /admin.
ADMIN_FIREBASE_UIDS=
# Extra allowed browser origins. WEB_APP_URL is always allowed.
CORS_ALLOWED_ORIGINS=
# Per-IP requests per minute; sensitive routes have their own limits.
RATE_LIMIT_MAX=300

# Optional Chzzk moderation (undocumented API; see docs/operations.md)
# Enable to remove displayed messages when a confirmed moderation event arrives.
CHZZK_PRIVATE_CHAT_MODERATION_ENABLED=false

# Temporary diagnostics (disabled by default)
CHZZK_BADGE_DIAGNOSTICS=false
# Test streamer Firebase UID allowlist for the private socket monitor.
CHZZK_PRIVATE_CHAT_DIAGNOSTIC_UIDS=

# Advanced API overrides. Omit these to use the public provider defaults.
# Do not set CHZZK_OPEN_API_BASE_URL to an empty value.
# CHZZK_OPEN_API_BASE_URL=https://openapi.chzzk.naver.com
# LICHESS_BASE_URL=https://lichess.org
