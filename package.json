{
  "name": "elobadge",
  "private": true,
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "dev": "pnpm --filter @elobadge/core build && pnpm --parallel --filter @elobadge/server --filter @elobadge/web dev",
    "dev:server": "pnpm --filter @elobadge/server dev",
    "dev:web": "pnpm --filter @elobadge/web dev",
    "chzzk:revoke-all": "pnpm --filter @elobadge/server chzzk:revoke-all",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-elobadge-emulator \"pnpm --filter @elobadge/server test:emulator:run\"",
    "typecheck": "pnpm --filter @elobadge/core build && pnpm -r typecheck",
    "lint": "pnpm --filter @elobadge/core build && pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "15.23.0",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
